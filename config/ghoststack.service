[Unit]
Description=GhostStack Master Orchestrator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/GhostStack
Environment=PYTHONPATH=/opt/GhostStack
Environment=GHOSTSTACK_PIDFILE=/opt/GhostStack/run/ghoststack.pid
ExecStart=/usr/bin/python3 scripts/ghoststack_ctl.py start-all
ExecStop=/usr/bin/python3 scripts/ghoststack_ctl.py stop-all
PIDFile=/opt/GhostStack/run/ghoststack.pid
Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/ghoststack.log
StandardError=append:/var/log/ghoststack_error.log

[Install]
WantedBy=multi-user.target
